# CM-PGRP Root Environment Configuration Example
# Server Port
PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=kerala_cmo_secret_key_2026_super_secure

# CORS Allowed Origin (for standalone dev mode)
CORS_ORIGIN=http://localhost:5173

# SQLite Database Storage Location
DATABASE_PATH=./data/cm_pgrp.sqlite

# Supporting Files Upload Directory
UPLOAD_DIR=./uploads

# Google Gemini AI Integration (Optional)
# If provided, uses Gemini 1.5/2.0 API. If blank, automatically uses the labelled intelligent offline NLP fallback.
GEMINI_API_KEY=
